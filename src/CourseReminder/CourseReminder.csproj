<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>CourseReminder</RootNamespace>
    <AssemblyName>CourseReminder</AssemblyName>
    <Version>0.1.7</Version>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <!--
      绿色便携：发布命令为 dotnet publish -c Release -r win-x64，参数 self-contained=false，输出目录 dist。
      产物为免安装文件夹版（exe + dll + 运行时配置），数据全部写在 exe 同级 data/。
      RID 不写入 csproj：日常构建离线可用，不触发远程运行时包下载。
    -->
  </PropertyGroup>

</Project>
