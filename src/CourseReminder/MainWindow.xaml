<Window x:Class="CourseReminder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="课表提醒" Height="560" Width="760"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="课表提醒" FontSize="18" FontWeight="Bold"
                   Margin="16,10,16,4" Foreground="#4472C4"/>
        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="8" Padding="4"
                    SelectionChanged="MainTabs_SelectionChanged">

            <!-- ========== 本周课表 ========== -->
            <TabItem Header="本周课表">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
                        <Button Content="上一周" Padding="10,2" Click="PrevWeek_Click"/>
                        <Button Content="本周" Padding="10,2" Margin="6,0,0,0" Click="ThisWeek_Click"/>
                        <Button Content="下一周" Padding="10,2" Margin="6,0,0,0" Click="NextWeek_Click"/>
                        <TextBlock x:Name="WeekRangeText" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <Grid x:Name="WeekGrid" MinWidth="700"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ========== 今日课表 ========== -->
            <TabItem Header="今日课表">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock x:Name="TodayDateText" FontSize="14" VerticalAlignment="Center"/>
                        <Button Content="刷新" Margin="12,0,0,0" Padding="12,2" Click="RefreshToday_Click"/>
                    </StackPanel>
                    <ListBox x:Name="TodayList" Grid.Row="1" FontSize="14">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock FontWeight="Bold" Text="{Binding TimeRange}"/>
                                    <TextBlock Text="{Binding CourseInfo}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- ========== 导入课表 ========== -->
            <TabItem Header="导入课表">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
                        <Button Content="选择 Excel 文件 (.xlsx)" Padding="12,4" Click="SelectExcel_Click"/>
                        <Button Content="手动录入 / 编辑课程" Padding="12,4" Margin="8,0,0,0" Click="ManualEdit_Click"
                                ToolTip="没有 Excel 也能逐门录入；与导入共用同一份课表"/>
                        <TextBlock x:Name="ImportFileText" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" x:Name="ImportStatusText" Margin="0,0,0,6" TextWrapping="Wrap"/>
                    <ListBox x:Name="ImportPreviewList" Grid.Row="2" FontSize="13"/>
                    <StackPanel Orientation="Horizontal" Grid.Row="3" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button x:Name="ConfirmImportBtn" Content="确认导入" Padding="16,4" Margin="0,0,8,0"
                                Click="ConfirmImport_Click" IsEnabled="False"/>
                        <Button x:Name="CancelImportBtn" Content="取消" Padding="16,4"
                                Click="CancelImport_Click" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ========== 设置 ========== -->
            <TabItem Header="设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
                    <StackPanel Margin="8,8,8,20">
                        <TextBlock Text="提醒" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="课前提前提醒（分钟）：" VerticalAlignment="Center" Width="180"/>
                            <TextBox x:Name="AdvanceMinutesBox" Width="80" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <CheckBox x:Name="PlaySoundBox" Content="提醒时播放提示音" Margin="0,0,0,16"/>

                        <TextBlock Text="学期" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="学期第一周的周一：" VerticalAlignment="Center" Width="180"/>
                            <DatePicker x:Name="FirstMondayPicker" Width="160"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="学期结束日期：" VerticalAlignment="Center" Width="180"/>
                            <DatePicker x:Name="EndDatePicker" Width="160"/>
                        </StackPanel>
                        <TextBlock x:Name="WeekInfoText" Margin="0,0,0,20" Foreground="Gray"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="保存设置" Padding="20,6" Click="SaveSettings_Click"/>
                            <Button Content="测试提醒" Padding="20,6" Margin="12,0,0,0" Click="TestReminder_Click"
                                    ToolTip="立刻弹一条示例提醒，用来确认通知与提示音是否正常"/>
                            <Button Content="退出课表提醒" Padding="20,6" Margin="12,0,0,0" Click="QuitApp_Click"
                                    ToolTip="结束程序并停止提醒（唯一的退出入口）"/>
                        </StackPanel>
                        <TextBlock x:Name="SettingsStatusText" Margin="0,8,0,0" Foreground="Green"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========== 关于 ========== -->
            <TabItem Header="关于">
                <StackPanel Margin="16">
                    <TextBlock Text="课表提醒 v0.1.7" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                    <TextBlock Text="课前定时提醒 Windows 桌面小程序" Margin="0,0,0,4"/>
                    <TextBlock Text="· 绿色便携：数据全部在程序文件夹 data/ 内" Margin="0,0,0,4"/>
                    <TextBlock Text="· 完全离线：导入 Excel 后无需联网，也可手动逐门录入" Margin="0,0,0,4"/>
                    <TextBlock Text="· 提前量 1~180 分钟可配置，错过不补发，学期结束自动停止提醒" Margin="0,0,0,4"/>
                    <TextBlock Text="· 点窗口 X 只是最小化到任务栏，提醒继续运行；退出请用「设置」页的「退出课表提醒」" Margin="0,0,0,16"/>
                    <TextBlock Text="数据目录：" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock x:Name="DataDirText" TextWrapping="Wrap" Foreground="Gray"/>
                </StackPanel>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
