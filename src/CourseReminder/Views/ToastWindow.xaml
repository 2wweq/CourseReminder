<Window x:Class="CourseReminder.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        SizeToContent="Height" Width="380" ShowActivated="False"
        WindowStartupLocation="Manual" Cursor="Hand">
    <Border CornerRadius="10" Background="#FFFFFF" BorderBrush="#D5DCE6" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.26" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#4472C4" CornerRadius="10,0,0,10"/>
            <StackPanel Grid.Column="1" Margin="14,11,14,11">
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="Bold"
                           Foreground="#1F2937" TextWrapping="Wrap"/>
                <TextBlock x:Name="BodyText" FontSize="13" Foreground="#374151"
                           TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="20"/>
                <TextBlock Text="点击查看今日剩余课程" FontSize="11"
                           Foreground="#9CA3AF" Margin="0,9,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
