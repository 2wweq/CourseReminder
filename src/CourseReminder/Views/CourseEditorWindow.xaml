<Window x:Class="CourseReminder.Views.CourseEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="手动录入课表" Height="480" Width="760"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左：已有课程 -->
        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="已有课程" FontWeight="Bold" Margin="0,0,0,6"/>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="新增一门" Padding="12,3" Click="Add_Click"/>
                <Button x:Name="DeleteBtn" Content="删除选中" Padding="12,3" Margin="8,0,0,0"
                        Click="Delete_Click" IsEnabled="False"/>
            </StackPanel>
            <ListBox x:Name="CourseList" FontSize="13" SelectionChanged="CourseList_SelectionChanged"/>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Stretch" Background="Transparent"/>

        <!-- 右：编辑表单 -->
        <StackPanel Grid.Column="2">
            <TextBlock x:Name="EditorTitle" Text="编辑课程" FontWeight="Bold" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="星期：" Width="76" VerticalAlignment="Center"/>
                <ComboBox x:Name="WeekdayCombo" Width="120"/>
                <TextBlock Text="大节：" Width="56" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <ComboBox x:Name="SlotCombo" Width="150"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="课程名：" Width="76" VerticalAlignment="Center"/>
                <TextBox x:Name="NameBox" Width="380" VerticalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="教室：" Width="76" VerticalAlignment="Center"/>
                <TextBox x:Name="RoomBox" Width="200" VerticalContentAlignment="Center"/>
                <TextBlock Text="教师：" Width="56" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <TextBox x:Name="TeacherBox" Width="120" VerticalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="周次规则：" Width="76" VerticalAlignment="Center"/>
                <TextBox x:Name="WeekRuleBox" Width="180" VerticalContentAlignment="Center"/>
                <TextBlock Text="留空=每周，可填 单周 / 双周 / 1-16" FontSize="11"
                           Foreground="Gray" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock x:Name="EditorStatus" Foreground="DarkRed" TextWrapping="Wrap" Margin="0,6,0,10"/>

            <StackPanel Orientation="Horizontal">
                <Button x:Name="SaveBtn" Content="保存修改" Padding="16,4" Click="Save_Click" IsEnabled="False"/>
                <Button Content="关闭" Padding="16,4" Margin="8,0,0,0" Click="Close_Click"/>
            </StackPanel>

            <TextBlock Text="提示：这里改的是本机 data/schedule.json，与 Excel 导入共用同一份课表；导入会整份替换。"
                       FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,16,0,0"/>
        </StackPanel>
    </Grid>
</Window>
